# FriendlyTeaching.cl — Environment Variables
# Copy this file to .env.local and fill in the values

# Firebase Configuration (public frontend keys)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Teacher Registration Code
NEXT_PUBLIC_TEACHER_CODE=

# App URL (set to your Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Teacher email for student registration notifications
NEXT_PUBLIC_TEACHER_EMAIL=

# Resend API Key for email sending (get free key at resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Default From address for outgoing emails. Must be a verified domain in Resend.
# Falls back to 'FriendlyTeaching <onboarding@resend.dev>' when unset.
# RESEND_FROM=Ignacio Frau Figueroa <noreply@friendlyteaching.cl>

# ── Class access-link reminder cron ───────────────────────────────────────
# Shared Google Meet link sent 15 min before every class. Required for the
# /api/cron/send-class-reminders job — the cron refuses to send without it.
# GOOGLE_MEET_LINK=https://meet.google.com/xxx-xxxx-xxx
# Secret for Vercel to authenticate against the cron endpoint. Set the same
# value here and in the Vercel project env; Vercel adds `Authorization:
# Bearer $CRON_SECRET` to every scheduled hit.
# CRON_SECRET=generate-a-long-random-string
# Address BCC'd on every access-link email so the academy has a record.
# Defaults to friendlyteaching.cl@gmail.com when unset.
# CLASS_REMINDER_BCC=friendlyteaching.cl@gmail.com
# Address replies to the access-link email go to. Defaults to Ignacio's Gmail.
# CLASS_REMINDER_REPLY_TO=ifraufigueroa@gmail.com

# Firebase Admin SDK — required for server-side actions like manually
# creating student accounts from the teacher dashboard.
# Download a service account key from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the FULL JSON as a single-line string (escape newlines with \n if needed):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com",...}

# Anthropic Claude API — powers the AI CLT lesson generator (music-lesson,
# text-lesson, ai-lesson routes). Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# CLAUDE_MODEL=claude-sonnet-4-6

# ElevenLabs TTS — powers /api/tts/elevenlabs used by Friendlytext to
# synthesise audio for text lessons. Get a key at
# https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
