rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(userPath)
        ? get(userPath).data.get('role', null)
        : null;
    }

    // Known teacher emails — used as reliable fallback when Firestore document
    // lookup (getUserRole) fails or the role field is missing/wrong.
    function isKnownTeacherEmail() {
      return request.auth != null && (
        request.auth.token.email == 'ifraufigueroa@gmail.com' ||
        request.auth.token.email == 'aranxa.brunam@gmail.com'
      );
    }

    function isTeacher() {
      return getUserRole() == 'teacher' || isKnownTeacherEmail();
    }

    function isMaster() {
      return getUserRole() == 'master';
    }

    // Corporate admin — reads progress for employees in their org.
    // Keep the gate narrow for list queries, but allow read on individual
    // docs so the roster + drill-down pages work.
    function isCorporate() {
      return getUserRole() == 'corporate';
    }

    // Returns the teacherId that approved the currently-authenticated student.
    // Used so students can read their own teacher's lesson plans and class history
    // even when the documents lack a studentId field (name-only bookings).
    function getStudentTeacherId() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(userPath)
        ? get(userPath).data.get('studentData', {}).get('approvedByTeacherId', null)
        : null;
    }

    function isApprovedStudent() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userPath)
        && get(userPath).data.get('role', null) == 'student'
        && get(userPath).data.get('status', null) == 'approved';
    }

    match /users/{userId} {
      // Single-document reads: owner, any teacher, master, approved student
      // reading their teacher's doc, or a corporate admin reading an employee
      // of their organization.
      allow get: if isOwner(userId)
                   || isTeacher()
                   || isMaster()
                   || isCorporate()
                   || (isApprovedStudent() && resource.data.role == 'teacher');

      // Collection list queries (useStudents does a bare collection scan and filters client-side).
      // isKnownTeacherEmail() is checked FIRST — it uses request.auth.token (no Firestore get()
      // call needed), which avoids the rules-engine stall that isTeacher() / getUserRole() can
      // trigger when get() is evaluated per-document inside a list operation.
      allow list: if isKnownTeacherEmail() || getUserRole() == 'teacher' || isMaster();

      allow create: if isOwner(userId);
      // C2 fix (audit 2026-11-23): owner update was `isOwner(userId) || isTeacher()`
      // with NO field allowlist, so a student could direct-write
      // role:'teacher'/status:'approved' from the console. Owner is now
      // scoped to the safe fields they actually need from the profile UI.
      // Teachers (and the Admin SDK via the kill-switch) stay unrestricted.
      allow update: if isTeacher()
                      || (isOwner(userId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['fullName', 'phone', 'bio', 'preferences', 'teacherData', 'updatedAt']));
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      // C3 fix (audit 2026-11-23): read was `isAuthenticated()` — any student
      // could pull every booking on the platform. Now scoped: teacher/master/
      // corporate read freely; a student only sees docs where they are the
      // studentId. Student-side queries must filter `where('studentId','==',uid)`
      // (useStudentBookings does so).
      allow read: if isTeacher() || isMaster() || isCorporate()
                    || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }


    // Booking requests — only authenticated students with an approved account can create.
    // Students can read their own requests; teachers can read, update, and delete.
    match /bookingRequests/{reqId} {
      allow create: if isApprovedStudent() &&
                      request.resource.data.studentId == request.auth.uid;
      allow read:   if isTeacher() ||
                      (isApprovedStudent() && resource.data.studentId == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    match /weeklySchedule/{slotId} {
      // C4 fix (audit 2026-11-23): tightened from `isAuthenticated()` so
      // pending students and unauthenticated users can't enumerate every
      // teacher's slots. Approved students can still read (they need to see
      // their teacher's available openings to request a class).
      allow read: if isTeacher() || isMaster() || isApprovedStudent();
      allow write: if isTeacher();
    }

    match /lessons/{lessonId} {
      allow read: if isTeacher() ||
                    (isApprovedStudent() && resource.data.isPublished == true);
      allow write: if isTeacher();
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /progress/{progressId} {
      allow read: if isTeacher() ||
                    (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isApprovedStudent() &&
                      request.resource.data.studentId == request.auth.uid;
      allow update: if isApprovedStudent() &&
                      resource.data.studentId == request.auth.uid;
      allow delete: if false;
    }

    // ── Live Sessions ──────────────────────────────────────────
    // Key = lessonId (one active session per lesson at a time).
    // Teacher: full read/write.  Student: read if in assignedStudents list.
    match /liveSessions/{lessonId} {
      allow read: if isAuthenticated() && (
        isTeacher() ||
        (isApprovedStudent() && request.auth.uid in resource.data.assignedStudents)
      );
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if false;

      // Student canvas subcollection — each student writes only their own doc
      match /studentCanvases/{studentId} {
        allow read: if isAuthenticated() && (
          isTeacher() || request.auth.uid == studentId
        );
        allow write: if isApprovedStudent() && request.auth.uid == studentId;
      }
    }

    match /classHistory/{entryId} {
      allow read: if isTeacher() || isMaster()
                   || (isApprovedStudent() && resource.data.studentId == request.auth.uid)
                   || (isApprovedStudent() && resource.data.teacherId == getStudentTeacherId());
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    match /payments/{paymentId} {
      allow read: if isMaster()
                   || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /levelHistory/{entryId} {
      allow read: if isTeacher() ||
                    (isApprovedStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if false;
    }

    match /skillAssessments/{assessmentId} {
      allow read: if isTeacher() ||
                    (isApprovedStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    match /activities/{activityId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    match /homework/{hwId} {
      // QW4: Allow students to read class-wide homework (assignedToStudentId == null)
      allow read: if isTeacher() ||
                    (isApprovedStudent() &&
                      (resource.data.assignedToStudentId == request.auth.uid
                       || resource.data.assignedToStudentId == null));
      allow create: if isTeacher();
      allow update: if isTeacher() ||
                      (isApprovedStudent() &&
                       resource.data.assignedToStudentId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['submittedAt', 'submittedAnswers', 'status', 'updatedAt']));
      allow delete: if isTeacher();
    }

    // ── Gamification ────────────────────────────────────────────
    // Each student has one gamification doc keyed by their uid.
    // Students can read/write their own; teachers can read all.
    match /gamification/{studentId} {
      allow read: if isOwner(studentId) || isTeacher();
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId);
      allow delete: if false;
    }

    // ── Random Topic Simulator progress ─────────────────────────
    // Doc per student tracking which cue cards have been practiced.
    // Teacher drives practice during the class, so the teacher needs
    // write access in addition to the student.
    match /randomTopicProgress/{studentId} {
      allow read:   if isOwner(studentId) || isTeacher();
      allow create: if isOwner(studentId) || isTeacher();
      allow update: if isOwner(studentId) || isTeacher();
      allow delete: if false;
    }

    // ── Word of the Day Submissions ───────────────────────────
    // Students submit daily examples; teachers can review all.
    match /wordOfDaySubmissions/{subId} {
      allow read: if isAuthenticated() && (
        isTeacher() || resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
                      request.resource.data.studentId == request.auth.uid;
      // Teachers may write feedback fields on any submission; the
      // student that owns the doc can ONLY flip feedbackReadAt so the
      // "(1)" badge clears when they open it. Everything else is
      // immutable.
      allow update: if isTeacher() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['feedback', 'feedbackAt', 'feedbackByTeacherId'])
                    || (request.auth != null
                        && resource.data.studentId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['feedbackReadAt']));
      allow delete: if false;
    }

    // ── Per-student lesson plans ───────────────────────────────
    // Only the teacher writes; plan IDs are composite keys
    // (teacherId_studentId_lessonId) so no other party can guess them.
    match /studentLessonPlans/{planId} {
      allow read, write: if isTeacher();
    }

    // ── Placement Assignments ─────────────────────────────────
    match /placementAssignments/{assignmentId} {
      allow read: if isTeacher()
                  || (isApprovedStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher();
      allow update: if isTeacher()
                  || (isApprovedStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isTeacher();
    }

    // ── Lesson Plans (class counter) ──────────────────────────
    match /lessonPlans/{planId} {
      allow read: if isTeacher() || isMaster()
                   || (isApprovedStudent() && resource.data.studentId == request.auth.uid)
                   || (isApprovedStudent() && resource.data.teacherId == getStudentTeacherId());
      allow write: if isTeacher();
    }

    // ── Music Lessons (Friendlyrics®) ────────────────────────────
    // Library is shared across teachers: any teacher can read every lesson,
    // and any teacher can update the assignedTo list (to assign their own
    // students). Edits to other fields and deletes stay restricted to the
    // creator (teacherId == request.auth.uid).
    match /musicLessons/{lessonId} {
      allow read: if isTeacher() ||
                    (isApprovedStudent() && request.auth.uid in resource.data.assignedTo);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && (
                      resource.data.teacherId == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['assignedTo', 'updatedAt'])
                    );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── Movie Lessons (Friendlyflix®) ────────────────────────────
    // Same shared-library model as musicLessons: any teacher reads
    // every clip lesson, any teacher updates assignedTo, only owner
    // edits or deletes.
    match /movieLessons/{lessonId} {
      // Unified read rule (same shape as musicLessons). Firestore
      // evaluates this per returned doc on list queries, which works
      // because the student-side hook filters by
      // `assignedTo array-contains studentId` — every doc the query can
      // return already satisfies the rule. The old split rule rejected
      // student list queries silently, leaving My Lessons empty.
      allow read: if isTeacher() ||
                    (isApprovedStudent() && request.auth.uid in resource.data.assignedTo);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && (
                      resource.data.teacherId == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['assignedTo', 'updatedAt'])
                    );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── Text Lessons (Friendlytext® — CLT text-based) ────────────
    // Same shared-library model as musicLessons / movieLessons.
    match /textLessons/{lessonId} {
      // See movieLessons above for why list/get is unified here.
      allow read: if isTeacher() ||
                    (isApprovedStudent() && request.auth.uid in resource.data.assignedTo);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && (
                      resource.data.teacherId == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['assignedTo', 'updatedAt'])
                    );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── Student Assignments (unificado FT + external) ────────
    // Un doc por (student, material). Los profes crean/leen/actualizan/
    // borran las asignaciones que ellos mismos hicieron. El estudiante
    // sólo puede leer las suyas propias (no crearlas ni borrarlas).
    match /studentAssignments/{assignmentId} {
      // C5 fix (audit 2026-11-23): `request.auth.uid != null` was tautological
      // for authenticated users, so any student could list every assignment on
      // the platform. Now per-doc: student must query with
      // `where('studentId','==',uid)` so every returned row matches. useStudentAssignments
      // already does this.
      allow list: if isTeacher() ||
                    (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow get:  if isTeacher() ||
                    (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── Evaluation Requests (landing page leads) ──────────────
    // Written server-side via Firebase Admin SDK (bypasses rules);
    // teachers list/read/update to manage lead status.
    match /evaluationRequests/{leadId} {
      allow list, get: if isTeacher();
      allow create: if false;
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ── IELTS Listening audio bindings ────────────────────────
    // Persists the (teacher, mock, section) → audioUrl mapping so ElevenLabs
    // generations survive reloads. Doc ID is `${teacherId}_${mockId}_${section}`,
    // and every doc carries a teacherId field the teacher owns.
    match /ieltsListeningAudios/{bindingId} {
      allow read:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow list:   if isTeacher();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── Placement Sessions ─────────────────────────────────────
    // Public: anyone (including unauthenticated visitors) can CREATE a session
    // (to take the placement test without logging in).
    // Only the owning teacher can READ or UPDATE sessions.
    match /placementSessions/{sessionId} {
      allow create: if true;  // public — no login required
      allow read:   if (isTeacher() && resource.data.teacherId == request.auth.uid)
                      || isCorporate();
      allow update: if (
        // Teacher can update (link student, etc.)
        (isTeacher() && resource.data.teacherId == request.auth.uid)
        ||
        // Unauthenticated continuation: allow updating own in-progress session.
        // We allow update if the incoming data keeps the teacherId unchanged,
        // the status is still in_progress or being completed, and no auth is required.
        // This covers the periodic progress saves from the public test page.
        (!isAuthenticated() && resource.data.status == 'in_progress')
      );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Complete Placement (suite) — same access model as placementSessions.
    // Public: create + update while in_progress; teacher: read/update/delete own.
    match /placementSuiteSessions/{sessionId} {
      allow create: if true;
      allow read:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update: if (
        (isTeacher() && resource.data.teacherId == request.auth.uid)
        ||
        // C6 fix (audit 2026-11-23): old rule `request.resource.data.teacherId ==
        // resource.data.teacherId` let an unauthenticated scraper overwrite ANY
        // doc (completed included) as long as teacherId was unchanged. Now gated
        // on status still being in_progress.
        (resource.data.status == 'in_progress'
          && request.resource.data.teacherId == resource.data.teacherId)
      );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // TOEFL Academic Simulator — same public-create / teacher-owns pattern.
    match /toeflSessions/{sessionId} {
      allow create: if true;
      allow read:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update: if (
        (isTeacher() && resource.data.teacherId == request.auth.uid)
        ||
        // C6 fix (audit 2026-11-23): same status gate as placementSuiteSessions.
        (resource.data.status == 'in_progress'
          && request.resource.data.teacherId == resource.data.teacherId)
      );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // TOEFL Speaking assignments — teacher creates; student runs from link.
    // Same public-write pattern as toeflSessions: single-doc GET is open (the
    // id is the token), LIST stays teacher-only, updates keep teacherId locked
    // AND must leave status still in_progress.
    match /toeflSpeakingAssignments/{assignmentId} {
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      // C6 fix (audit 2026-11-23): split read → get:true / list:teacher-only.
      // Previous `allow read: if true` let anyone enumerate every assignment.
      allow get:    if true;
      allow list:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update: if (
        (isTeacher() && resource.data.teacherId == request.auth.uid)
        ||
        (resource.data.status == 'in_progress'
          && request.resource.data.teacherId == resource.data.teacherId)
      );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // TOEFL Writing assignments — same pattern as toeflSpeakingAssignments.
    match /toeflWritingAssignments/{assignmentId} {
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      // C6 fix — split read; close enumeration.
      allow get:    if true;
      allow list:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update: if (
        (isTeacher() && resource.data.teacherId == request.auth.uid)
        ||
        (resource.data.status == 'in_progress'
          && request.resource.data.teacherId == resource.data.teacherId)
      );
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // TOEFL Listening audio bindings — mirrors ieltsListeningAudios.
    match /toeflListeningAudios/{bindingId} {
      allow read:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Placement Listening audio bindings — same pattern (teacher-owned).
    match /placementListeningAudios/{bindingId} {
      allow read:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Friendlistenings audio bindings — shared across students, so one audio
    // per lesson for the whole platform. Any authenticated user can read
    // (students stream the mp3); only teachers can write.
    match /friendlisteningsAudios/{lessonId} {
      allow read:   if isAuthenticated();
      allow create: if isTeacher() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // FriendlyWriting submissions — a student writes their own piece and
    // hands it in; the teacher reads the whole inbox and can flip the
    // `reviewed` flag after reading it in class.
    match /friendlywritingSubmissions/{submissionId} {
      allow read:   if isTeacher() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Practice audios — seeded by scripts/generate-practice-audios.js
    // with one doc per listen-choose exercise. Student reads only (the
    // URL is public-ish, served from Storage); writes are admin-only
    // (service account via the script).
    match /practiceAudios/{exerciseId} {
      allow read:   if isAuthenticated();
      allow write:  if isTeacher();
    }

    // HTML lesson responses — when the HTML slide renderer auto-wires
    // <input>/<textarea>/<select>/<radio>/<checkbox> and persists what
    // the student types, each (student, lesson) pair upserts one doc
    // keyed by `${lessonId}_${studentId}`.
    //
    // Student may read + write only their own doc. Teacher may list
    // the whole collection (narrowed by teacherId in queries) and read
    // any doc that belongs to one of their lessons.
    match /htmlLessonResponses/{responseId} {
      // Only teachers can enumerate the collection; students don't need
      // list access — their own doc is addressed by composite id.
      allow list:   if isTeacher();
      // Allow get on a non-existent doc so the student's onSnapshot can
      // subscribe before the first write. When the doc exists, the
      // student can only read their own.
      allow get:    if isTeacher() ||
                      (request.auth != null && (
                        resource == null ||
                        resource.data.studentId == request.auth.uid
                      ));
      allow create: if request.auth != null
                      && request.resource.data.studentId == request.auth.uid;
      allow update: if request.auth != null
                      && resource.data.studentId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Friendly product assignments — Friendlistenings and FriendlyWriting
    // lessons are static files, so each assignment lives as its own tiny
    // doc. Same shape as studentAssignments: teacher owns and mutates;
    // student reads only their own.
    match /friendlisteningAssignments/{assignmentId} {
      // C5 fix (same pattern as studentAssignments).
      allow list:   if isTeacher() ||
                      (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow get:    if isTeacher() ||
                      (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }
    match /friendlywritingAssignments/{assignmentId} {
      // C5 fix (same pattern as studentAssignments).
      allow list:   if isTeacher() ||
                      (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow get:    if isTeacher() ||
                      (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── COWORK (workspace del equipo docente) ─────────────────
    // Chat, anuncios y presencia — sólo profesores. Cada profe crea
    // sus propios docs (authorId == su uid) y puede editar/borrar los
    // propios; el resto son de sólo lectura para los demás profes.
    //
    // Excepciones intencionales:
    //  - Anuncios: cualquier profe puede fijar/desfijar y marcar como
    //    leído (afecta sólo pinned / readBy / updatedAt).
    //  - Presencia: cada profe escribe únicamente su propio doc (id = uid).
    match /coworkMessages/{msgId} {
      allow read:   if isTeacher();
      allow create: if isTeacher() && request.resource.data.authorId == request.auth.uid;
      allow update: if isTeacher() && resource.data.authorId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.authorId == request.auth.uid;
    }

    match /coworkAnnouncements/{annId} {
      allow read:   if isTeacher();
      allow create: if isTeacher() && request.resource.data.authorId == request.auth.uid;
      allow update: if isTeacher() && (
                      resource.data.authorId == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['pinned', 'readBy', 'updatedAt'])
                    );
      allow delete: if isTeacher() && resource.data.authorId == request.auth.uid;
    }

    match /coworkPresence/{uid} {
      allow read:  if isTeacher();
      allow write: if isTeacher() && request.auth.uid == uid;
    }

    // ── Organizations (corporate Master Account) ─────────────────
    // Each doc keyed by orgId. Admins (adminUids array) can read + update
    // their own org. Teachers can read all (support/setup). Masters read all.
    match /organizations/{orgId} {
      allow read:   if isTeacher() || isMaster()
                      || (isAuthenticated() && request.auth.uid in resource.data.adminUids)
                      || (isAuthenticated() && request.auth.uid in resource.data.studentUids);
      allow create: if isTeacher() || isMaster();
      allow update: if isTeacher() || isMaster()
                      || (isAuthenticated() && request.auth.uid in resource.data.adminUids);
      allow delete: if isTeacher() || isMaster();

      // Group subcollection — 4-5 person cohorts the corporate monitor
      // groups by level + weekly slot. Subcollections don't inherit the
      // parent's rules, so permissions are declared explicitly here and
      // mirror the parent's shape via get() on the org doc.
      match /groups/{groupId} {
        allow read: if isTeacher() || isMaster()
                      || (isAuthenticated() && request.auth.uid in
                            get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids)
                      || (isAuthenticated() && request.auth.uid in
                            get(/databases/$(database)/documents/organizations/$(orgId)).data.studentUids);
        allow write: if isTeacher() || isMaster()
                       || (isAuthenticated() && request.auth.uid in
                             get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids);
      }

      // Change requests raised from the Estudiantes tab — admins create
      // and read their own org's queue; teachers can read + update (to
      // mark as resolved) once the admin-side flow lands.
      match /changeRequests/{reqId} {
        allow read: if isTeacher() || isMaster()
                      || (isAuthenticated() && request.auth.uid in
                            get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids);
        allow create: if isAuthenticated()
                        && request.auth.uid in
                             get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids
                        && request.resource.data.createdByUid == request.auth.uid
                        && request.resource.data.status == 'pending';
        allow update: if isTeacher() || isMaster();
        allow delete: if isTeacher() || isMaster();
      }
    }

    // ── Daily Practice progress ──────────────────────────────────
    // One doc per student. Owner read/write. Teacher + master + corporate read.
    match /practiceProgress/{studentId} {
      allow read:   if isOwner(studentId) || isTeacher() || isMaster() || isCorporate();
      allow create, update: if isOwner(studentId);
      allow delete: if false;
    }

    // ── Daily Practice sessions (per-lesson history) ─────────────
    // One subcollection per student. Owner writes; teacher/master/corporate read.
    match /practiceSessions/{studentId}/items/{sessionId} {
      allow read:   if isOwner(studentId) || isTeacher() || isMaster() || isCorporate();
      allow create: if isOwner(studentId);
      allow update, delete: if false;
    }

    // ── Daily Practice pronunciation attempts ────────────────────
    // One subcollection per student. Student creates when they pass
    // or give up on a pronunciation exercise; teacher reads for the
    // visibility tab. Docs are immutable once written (any correction
    // should land as a new attempt).
    match /pronunciationAttempts/{studentId}/items/{attemptId} {
      allow read:   if isOwner(studentId) || isTeacher() || isMaster() || isCorporate();
      allow create: if isOwner(studentId);
      allow update, delete: if false;
    }

    // ── Library reading progress ─────────────────────────────────
    // One doc per book under libraryProgress/{studentId}/items/{bookId}.
    // Owner writes (cfi + percent) as they read; teacher/master/corporate
    // read for visibility. The student can overwrite their own doc on
    // every page turn, so update is allowed in addition to create.
    match /libraryProgress/{studentId}/items/{bookId} {
      allow read:            if isOwner(studentId) || isTeacher() || isMaster() || isCorporate();
      allow create, update:  if isOwner(studentId);
      allow delete:          if false;
    }

    // ── Library ePub hosted URLs ─────────────────────────────────
    // One doc per pre-downloaded novel, populated by
    // scripts/upload-library-epubs.js. Shape: { epubUrl, bookId,
    // uploadedAt, size }. Student UI reads these to swap out the
    // direct Standard Ebooks URL for the Firebase Storage mirror.
    // Writes come from the admin SDK (bypasses rules).
    match /libraryEpubs/{bookId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Library highlights ───────────────────────────────────────
    // One doc per highlight under libraryHighlights/{studentId}/items/.
    // Owner creates and deletes; teacher/master/corporate read for
    // future visibility surfaces. Update is disabled because a change
    // in the highlighted text should land as a new row.
    match /libraryHighlights/{studentId}/items/{highlightId} {
      allow read:    if isOwner(studentId) || isTeacher() || isMaster() || isCorporate();
      allow create:  if isOwner(studentId);
      allow delete:  if isOwner(studentId);
      allow update:  if false;
    }

    // ── Daily Practice adaptive placement ────────────────────────
    // One doc per student at dailyPracticePlacement/{uid}, rewritten
    // on every answer so the session can resume mid-test. Owner
    // read/write; teachers can peek at their students' results.
    match /dailyPracticePlacement/{studentId} {
      allow read:          if isOwner(studentId) || isTeacher() || isMaster();
      allow create, update: if isOwner(studentId);
      allow delete:        if false;
    }

    // ── Weekly IELTS Academic assignments ────────────────────────
    // One doc per assignment (we may later key by studentId with upsert
    // semantics, but creating fresh docs keeps history). Student reads
    // their own, marks module progress and requests next mock. Teacher
    // creates/updates for the student they own.
    match /weeklyIeltsAssignments/{assignmentId} {
      // C5 fix (audit 2026-11-23): the old `request.auth != null` alone let
      // any student list every weekly IELTS assignment on the platform.
      // Now gated per-doc — student queries already filter by studentId.
      allow list:   if isTeacher() ||
                      (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow get:    if isTeacher() ||
                      (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      // Student can update ONLY their own doc, and only the progress fields.
      // Teacher can freely update their own students' assignments.
      allow update: if (isTeacher() && resource.data.teacherId == request.auth.uid)
                    || (request.auth != null
                        && resource.data.studentId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['currentMock', 'currentMockIndex', 'completedMocks', 'updatedAt']));
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // IELTS practice-mode saved sessions (per student, per mock) so the
    // teacher can resume where a student left off.
    match /ieltsPracticeSessions/{sessionId} {
      allow read:   if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

  }
}
